# Copy to backend/.env and adjust. Every field in app/config.py can be set here.

OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b
OLLAMA_NUM_CTX=8192
# Reasoning for thinking models (gemma4, qwen3), per phase. Unset = model default.
# false works on any model; true is rejected for models without thinking support (gemma3).
# Keep clip selection on the default: without reasoning gemma4 picks clips that are too short.
# SELECT_THINK=
CONTENT_THINK=false
VISION_THINK=false

# No-speech videos (< 30 words/min: music, gameplay, sport): clips from loudness/motion/scene-cut peaks,
# scored by Gemma looking at keyframes (needs a vision model; text-only models fall back to the signals)
NO_SPEECH_MODE=true
NO_SPEECH_CLIP_SECONDS=30
NO_SPEECH_VISION=true

WHISPER_MODEL=small
# Hindi speech -> transcript/captions/posts in Latin letters (Hinglish); per job on the New job form
HINGLISH_DEFAULT=true
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
# WHISPER_LANGUAGE=hi

# libx264 (always works) or h264_nvenc (fast, needs NVENC-enabled ffmpeg)
ENCODER=libx264

MAX_CLIP_SECONDS=59

# Jump cuts (silence + filler removal)
JUMPCUT_ENABLED=true
MAX_PAUSE=0.4
# JUMPCUT_AUDIO=true      # also find pauses in the audio, not only Whisper's word timings
# SILENCE_DROP_DB=25       # pause = this many dB under the speech level (lower for noisy rooms)
JUMPCUT_CROSSFADE_MS=10   # audio crossfade at each cut (no clicks); 0 = hard cuts
# JUMPCUT_ZOOM=true       # 5% punch-in on every other segment by default (also a per-short toggle)
# JUMPCUT_ZOOM_SCALE=1.05
HOOK_OVERLAY=true         # clip hook as a title card for the first HOOK_SECONDS (per-short toggle too)
HOOK_SECONDS=3

# Reframe: auto (two speakers -> TWO_SPEAKER_LAYOUT, else track the face) | face | split | speaker | center
REFRAME_MODE=auto
TWO_SPEAKER_LAYOUT=stack   # stack (both on screen) | speaker (cut to whoever is talking)
FACE_SMOOTHING=0.35
FACE_DEADZONE=0.05
REFRAME_LEAD=0.15          # lead room toward where the speaker looks/moves; 0 = always centred
LEAD_HOLD=2.0
REFRAME_NO_FACE=fit        # shots without a face: fit (whole frame over a blurred copy) | crop (centre crop)

# Content Studio (posts for YouTube / Instagram / X / LinkedIn)
CONTENT_ENABLED=true
CONTENT_PLATFORMS=["x","instagram","youtube","linkedin"]
CONTENT_LANGUAGE=English
CONTENT_VOICE=smart, friendly creator who explains things simply
BRAND_HANDLE=
CREDIT_SOURCE=false
CAROUSEL_ACCENT=#ff4d6d
COVER_STYLE=cutout         # reel cover: cutout (speaker cut out, ~170 MB model once) | frame
QUOTE_CARDS=true           # 1:1 + 4:5 quote card images (a line said in the clip) next to each short

# Captions: karaoke (word-by-word) | simple (whole line) | none
CAPTION_STYLE=karaoke
# Look: classic (the CAPTION_*/colour settings below) | punch | clean | boxed | neon | custom presets from
# data/caption_presets.json — e.g. {"mine": {"label": "Mine", "fonts": ["Bahnschrift"], "size": 90}}
CAPTION_PRESET=classic
CAPTION_POSITION=bottom      # bottom | middle
CAPTION_FONT=Arial
# ASS colours are &HAABBGGRR (note: BGR order)
HIGHLIGHT_COLOR=&H0000FFFF
KEYWORD_COLOR=&H0055FF55
CLIPS_PER_WINDOW=2
CAPTION_EMOJI=false        # colour emoji above caption lines (Noto Color Emoji, ~11 MB once); per short too

# Stat cards: a spoken number counts up on a card when it's said. Gemma suggests them while writing posts;
# only the ones you set to Show are burned in (INSERTS_AUTO=true shows them without asking)
INSERTS_SUGGEST=true
INSERTS_AUTO=false
INSERTS_MAX=2              # per short, at least 3 s apart

# Feed versions next to each 9:16 short, e.g. 4:5,1:1 (per short in the UI); each one adds a render
# EXTRA_ASPECTS=4:5

# Sound design for new shorts (per short in the UI): whoosh on cuts + pop on keywords, and a music track
# from data/sounds/music (ducked under the voice)
SFX_DEFAULT=false
# MUSIC_DEFAULT=lofi.mp3

# Watched folder: a video dropped here becomes a job once it stops growing (copied, never moved/deleted)
# WATCH_DIR=/mnt/c/Users/you/Videos/ClipForge inbox
# WATCH_CLIPS=5
# WATCH_MODE=review          # review | auto
# WATCH_TOPIC=

# History folders + "ClipForge history.xlsx" (default data/library)
# LIBRARY_DIR=/mnt/c/Users/you/Videos/ClipForge library

# If YouTube says "Sign in to confirm you're not a bot", export cookies.txt and point here
# YTDLP_COOKIES=/path/to/cookies.txt
