# Copy to backend/.env and adjust. Every field in app/config.py can be set here.

OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b
OLLAMA_NUM_CTX=8192
# Reasoning for thinking models (gemma4, qwen3), per phase. Unset = model default.
# false works on any model; true is rejected for models without thinking support (gemma3).
# Keep clip selection on the default: without reasoning gemma4 picks clips that are too short.
# SELECT_THINK=
CONTENT_THINK=false

WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
# WHISPER_LANGUAGE=hi

# libx264 (always works) or h264_nvenc (fast, needs NVENC-enabled ffmpeg)
ENCODER=libx264

MAX_CLIP_SECONDS=59

# Jump cuts (silence + filler removal)
JUMPCUT_ENABLED=true
MAX_PAUSE=0.4
JUMPCUT_CROSSFADE_MS=10   # audio crossfade at each cut (no clicks); 0 = hard cuts
# JUMPCUT_ZOOM=true       # 5% punch-in on every other segment by default (also a per-short toggle)
# JUMPCUT_ZOOM_SCALE=1.05
HOOK_OVERLAY=true         # clip hook as a title card for the first HOOK_SECONDS (per-short toggle too)
HOOK_SECONDS=3

# Reframe: auto (two speakers -> TWO_SPEAKER_LAYOUT, else track the face) | face | split | speaker | center
REFRAME_MODE=auto
TWO_SPEAKER_LAYOUT=stack   # stack (both on screen) | speaker (cut to whoever is talking)
FACE_SMOOTHING=0.35
FACE_DEADZONE=0.05
REFRAME_LEAD=0.15          # lead room toward where the speaker looks/moves; 0 = always centred
LEAD_HOLD=2.0

# Content Studio (posts for YouTube / Instagram / X / LinkedIn)
CONTENT_ENABLED=true
CONTENT_PLATFORMS=["x","instagram","youtube","linkedin"]
CONTENT_LANGUAGE=English
CONTENT_VOICE=smart, friendly creator who explains things simply
BRAND_HANDLE=
CREDIT_SOURCE=false
CAROUSEL_ACCENT=#ff4d6d

# Captions: karaoke (animated) | simple
CAPTION_STYLE=karaoke
CAPTION_FONT=Arial
# ASS colours are &HAABBGGRR (note: BGR order)
HIGHLIGHT_COLOR=&H0000FFFF
KEYWORD_COLOR=&H0055FF55
CLIPS_PER_WINDOW=2

# If YouTube says "Sign in to confirm you're not a bot", export cookies.txt and point here
# YTDLP_COOKIES=/path/to/cookies.txt
